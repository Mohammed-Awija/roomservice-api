generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationKind {
  HOTEL
  HOSTEL
  SHORT_TERM_RENTAL
  RESTAURANT
  CAFE
  BAR
  OTHER
}

enum LocationKind {
  ROOM
  TABLE
  AREA
  OTHER
}

enum MembershipRole {
  OWNER
  STAFF
}

enum RequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum OfferingNodeType {
  CATEGORY
  ITEM
}

enum ServiceComponentType {
  SINGLE_SELECT
  MULTI_SELECT
  IMAGE
  INFO_DISPLAY
  TIME_RANGE
  DATE
  TEXT_FIELD
  NUMBER
  GUEST_INFO
  QUANTITY_PRICED
  PRICE
  LINK
  WIFI_QR
}

enum ComponentSetBy {
  GUEST
  ADMIN
  NONE
}

model Organization {
  id                String             @id @default(uuid())
  slug              String             @unique
  name              String
  kind              OrganizationKind   @default(HOTEL)
  address           String?
  defaultLanguage   String             @default("en")
  timezone          String             @default("Europe/Istanbul")
  memberships       Membership[]
  locations         Location[]
  offeringNodes     OfferingNode[]
  serviceComponents ServiceComponent[]
  requests          Request[]
  locationOfferings LocationOffering[]

  // Design tokens. Null => guests get the built-in default theme.
  templates           Template[] @relation("OrganizationTemplates")
  publishedTemplateId String?
  publishedTemplate   Template?  @relation("PublishedTemplate", fields: [publishedTemplateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A named set of design tokens for an organization's guest pages.
/// The lifecycle (drafts, variants, publishing) lands in a later slice; this
/// exists now so token storage doesn't have to be migrated later.
model Template {
  id             String @id @default(uuid())
  organizationId String
  name           String
  /// Token schema version. Read-time defaulting means a v2 can add fields
  /// without backfilling existing rows.
  schemaVersion  Int    @default(1)
  /// Free-form JSON, but never trusted on read — sanitized against the
  /// whitelist before it reaches a public page.
  tokens         Json   @default("{}")

  organization Organization   @relation("OrganizationTemplates", fields: [organizationId], references: [id], onDelete: Cascade)
  publishedBy  Organization[] @relation("PublishedTemplate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Location {
  id             String             @id @default(uuid())
  organizationId String
  kind           LocationKind       @default(ROOM)
  name           String
  displayName    String?
  notes          String?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests       Request[]
  offerings      LocationOffering[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId])
}

model OfferingNode {
  id             String           @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  type           OfferingNodeType @default(ITEM)
  icon           String           @default("bell")
  enabled        Boolean          @default(true)
  displayOrder   Int              @default(0)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent        OfferingNode?      @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children      OfferingNode[]     @relation("NodeChildren")
  components    ServiceComponent[]
  requests      Request[]
  locationLinks LocationOffering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([parentId])
}

model LocationOffering {
  id             String @id @default(uuid())
  organizationId String
  locationId     String
  offeringNodeId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  offeringNode OfferingNode @relation(fields: [offeringNodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([locationId, offeringNodeId])
  @@index([organizationId])
  @@index([locationId])
}

model ServiceComponent {
  id             String               @id @default(uuid())
  organizationId String
  offeringNodeId String
  type           ServiceComponentType
  label          String
  config         Json                 @default("{}")
  setBy          ComponentSetBy       @default(GUEST)
  required       Boolean              @default(false)
  displayOrder   Int                  @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offeringNode OfferingNode @relation(fields: [offeringNodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([offeringNodeId])
}

model User {
  id          String       @id @default(uuid())
  clerkId     String       @unique
  email       String
  firstName   String?
  lastName    String?
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id             String         @id @default(uuid())
  userId         String
  organizationId String
  role           MembershipRole @default(OWNER)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([userId, organizationId])
}

model Request {
  id              String        @id @default(uuid())
  organizationId  String
  locationId      String
  offeringNodeId  String? // the tree item ordered
  itemName        String? // snapshot of the item name at order time
  selections      Json? // legacy: snapshot of chosen modifiers; reads move to componentValues
  componentValues Json? // snapshot of the guest's filled-in component values
  status          RequestStatus @default(PENDING)
  guestName       String?
  notes           String?
  assignedStaffId String?
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  offeringNode    OfferingNode? @relation(fields: [offeringNodeId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  acceptedAt      DateTime?
  completedAt     DateTime?

  @@index([organizationId])
  @@index([status])
}
